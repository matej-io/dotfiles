window-width = 215
window-height = 57
window-position-x = 362
window-position-y = 160
confirm-close-surface = false
font-size = 14
window-inherit-working-directory = false
clipboard-paste-protection = false
keybind = cmd+k=clear_screen
keybind = chain=text:\x0c



# Forward workspace/tab shortcuts to Herdr using CSI-u key sequences.
keybind = cmd+t=csi:116;9u
keybind = cmd+w=csi:119;9u
keybind = cmd+1=csi:49;9u
keybind = cmd+digit_1=csi:49;9u
keybind = alt+1=csi:49;3u
keybind = alt+digit_1=csi:49;3u
keybind = cmd+2=csi:50;9u
keybind = cmd+digit_2=csi:50;9u
keybind = alt+2=csi:50;3u
keybind = alt+digit_2=csi:50;3u
keybind = cmd+3=csi:51;9u
keybind = cmd+digit_3=csi:51;9u
keybind = alt+3=csi:51;3u
keybind = alt+digit_3=csi:51;3u
keybind = cmd+4=csi:52;9u
keybind = cmd+digit_4=csi:52;9u
keybind = alt+4=csi:52;3u
keybind = alt+digit_4=csi:52;3u
keybind = cmd+5=csi:53;9u
keybind = cmd+digit_5=csi:53;9u
keybind = alt+5=csi:53;3u
keybind = alt+digit_5=csi:53;3u
keybind = cmd+6=csi:54;9u
keybind = cmd+digit_6=csi:54;9u
keybind = alt+6=csi:54;3u
keybind = alt+digit_6=csi:54;3u
keybind = cmd+7=csi:55;9u
keybind = cmd+digit_7=csi:55;9u
keybind = alt+7=csi:55;3u
keybind = alt+digit_7=csi:55;3u
keybind = cmd+8=csi:56;9u
keybind = cmd+digit_8=csi:56;9u
keybind = alt+8=csi:56;3u
keybind = alt+digit_8=csi:56;3u
keybind = cmd+9=csi:57;9u
keybind = cmd+digit_9=csi:57;9u
keybind = alt+9=csi:57;3u
keybind = alt+digit_9=csi:57;3u
