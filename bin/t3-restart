#!/bin/sh
# Restart the T3 Code service (kills the running server and starts it again).
# Note: running this from inside a T3 session will drop that session's connection.
#
# Usage: t3-restart
# Linux: override the systemd user unit with T3_SYSTEMD_UNIT.
# macOS: override the launch agent label with T3_AGENT_LABEL.

case "$(uname -s)" in
    Linux)
        unit=${T3_SYSTEMD_UNIT:-t3-code.service}
        if systemctl --user restart "$unit"; then
            echo "restarted $unit"
            exit 0
        else
            echo "failed to restart $unit" >&2
            exit 1
        fi
        ;;
    Darwin) ;;
    *)
        echo "t3-restart supports Linux and macOS only" >&2
        exit 1
        ;;
esac

label=${T3_AGENT_LABEL:-com.t3tools.t3code.service}
target="gui/$(id -u)/$label"

if ! launchctl print "$target" >/dev/null 2>&1; then
    plist="$HOME/Library/LaunchAgents/$label.plist"
    if [ ! -f "$plist" ]; then
        echo "launch agent $label not found" >&2
        exit 1
    fi
    launchctl bootstrap "gui/$(id -u)" "$plist" || exit 1
fi

if launchctl kickstart -k "$target"; then
    echo "restarted $label"
else
    echo "failed to restart $label" >&2
    exit 1
fi
